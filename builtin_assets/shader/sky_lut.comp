//from https://github.com/AKGWSB/RealTimeAtmosphere
#version 450
#extension GL_ARB_separate_shader_objects: enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable

#define ATMOSPHERE_DESCRIPTOR_SET 0
#include "atmosphere.glsl"

layout(push_constant) uniform PushConstants {
    vec4 mainLightDir;
    vec4 mainLightColorIntensity;
    vec4 groundColorBrightness;
    float cameraHeight;
    float groundHorizonSin;
    float groundCurve;
};

vec3 FaceUVToViewDir(uint face, vec2 uv)
{
    vec2 p = uv * 2.0 - 1.0;
    p.y = -p.y;

    if(face == 0u) return normalize(vec3(1.0, p.y, -p.x));
    if(face == 1u) return normalize(vec3(-1.0, p.y, p.x));
    if(face == 2u) return normalize(vec3(p.x, 1.0, -p.y));
    if(face == 3u) return normalize(vec3(p.x, -1.0, p.y));
    if(face == 4u) return normalize(vec3(p.x, p.y, 1.0));
    return normalize(vec3(-p.x, p.y, -1.0));
}

layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
void main(){
    vec4 color = vec4(0, 0, 0, 1);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint face = gl_GlobalInvocationID.z;
    ivec2 imageExtent = imageSize(skyViewImage);
    if(pixel.x >= imageExtent.x || pixel.y >= imageExtent.y || face >= 6u)
        return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(imageExtent);
    vec3 viewDir = FaceUVToViewDir(face, uv);
    
    float h = cameraHeight + parameters.planetRadius;
    vec3 eyePos = vec3(0, h, 0);

    if (viewDir.y >= 0.0)
    {
        color.rgb = GetSkyView(eyePos, viewDir, mainLightDir.xyz, mainLightColorIntensity, -1.0);
    }
    else
    {
        vec3 sunLuminance = mainLightColorIntensity.rgb * mainLightColorIntensity.w *
                            parameters.sunLightIntensityFactor;
        vec3 directLight = vec3(0.0);
        if (mainLightDir.y > 0.0)
            directLight = sunLuminance * TransmittanceToAtmosphere(eyePos, mainLightDir.xyz) *
                          mainLightDir.y / PI;

        vec3 skyLight = GetSkyView(eyePos, vec3(0.0, 1.0, 0.0), mainLightDir.xyz,
                                  mainLightColorIntensity, -1.0);
        vec3 ground = groundColorBrightness.rgb * groundColorBrightness.a * (directLight + skyLight);
        float groundBlend = pow(smoothstep(0.0, groundHorizonSin, -viewDir.y), groundCurve);
        color.rgb = ground;
        if (groundBlend < 1.0)
        {
            vec3 horizonDir = normalize(vec3(viewDir.x, 0.0, viewDir.z));
            vec3 horizon = GetSkyView(eyePos, horizonDir, mainLightDir.xyz, mainLightColorIntensity, -1.0);
            color.rgb = mix(horizon, ground, groundBlend);
        }
    }
    imageStore(skyViewImage, ivec3(pixel, int(face)), color);
}
